# bpipe environment configuration
# Copy this to ~/.bpipe.env or .env in the project root

# ─── Betfair Credentials (required) ──────────────────────────────────────────
BETFAIR_APP_KEY=your_app_key_here
BETFAIR_USERNAME=your_username_here
BETFAIR_PASSWORD=your_password_here

# ─── Certificate Auth (optional, for bot/non-interactive login) ──────────────
# BETFAIR_CERT_PATH=/path/to/client-2048.pem
# BETFAIR_KEY_PATH=/path/to/client-2048.key

# ─── Betting Parameters ──────────────────────────────────────────────────────
BPIPE_STAKE=2.0            # Stake per bet in £
BPIPE_MIN_PROB=50          # Minimum win probability % to place a bet
BPIPE_MAX_ODDS=            # Maximum odds (empty = no limit)
BPIPE_PERSISTENCE=lapse    # lapse | persist | moc

# ─── Safety ──────────────────────────────────────────────────────────────────
BPIPE_DRY_RUN=true         # Set to "false" when you're ready to place real bets
